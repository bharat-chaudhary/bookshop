<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Bookshope.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %></title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://unpkg.com/swiper@7/swiper-bundle.min.css" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon_io/favicon-16x16.png">
    <link rel="manifest" href="favicon_io/site.webmanifest">
    
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        /* Basic hover effect for navigation links */
        .navbar-nav .nav-link {
            transition: all 0.3s ease;
        }

        /* On hover */
        .navbar-nav .nav-link:hover {
            background-color: #007bff; /* Bootstrap primary color */
            color: #fff; /* White text color on hover */
            border-radius: 5px; /* Optional: rounded corners */
        }

        /* Optional: active link with a subtle underline */
        .navbar-nav .nav-link.active {
            border-bottom: 2px solid #007bff;
        }

        /* Optional: adjust link size for mobile */
        .navbar-nav .nav-link {
            font-size: 18px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Header Section -->
        <header class="header bg-light shadow-sm mb-3">
            <div class="container">
                <div class="row align-items-center py-2">
                    <div class="col-md-6 text-center text-md-start">
                        <a href="#" class="logo text-decoration-none text-primary fs-4">
                            <i class="fas fa-book"></i> BookShop
                        </a>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <asp:Button ID="btnLogout" runat="server" CssClass="btn btn-outline-danger" Text="Logout" OnClick="btnLogout_Click" />
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-center" href="AdminHome.aspx">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-center" href="AdminUserManage.aspx">User Manage</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-center" href="AdminAddProduct.aspx">Book Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-center" href="AdminOrderManage.aspx">Order Manage</a>
                        </li>
                       
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Content Placeholder -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
